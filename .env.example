# Cấu hình server
PORT=3000
NODE_ENV=production

# AffiPad: thứ tự phải khớp public/voucher-config.js
AFFIPAD_API_KEY=
AFFIPAD_TOOL_ID_1=
AFFIPAD_TOOL_ID_2=
AFFIPAD_TOOL_ID_3=
AFFIPAD_TOOL_ID_4=

# Xác thực admin. ADMIN_SESSION_SECRET nên là chuỗi ngẫu nhiên dài và khác mật khẩu.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Giới hạn thời gian, tính bằng mili giây
EXTERNAL_REQUEST_TIMEOUT_MS=8000
PRODUCT_INFO_TIMEOUT_MS=1000
VOUCHER_TOTAL_TIMEOUT_MS=15000

# Nếu dùng Railway Volume, đặt file vào mount path, ví dụ /data/voucher-notice.json
VOUCHER_NOTICE_FILE=
NOTICE_FILE=

# API cũ, không bắt buộc đối với trang Voucher chính
AFFILIATE_ID=
SHARE_CHANNEL_CODE=
DEFAULT_SUB1=addlivetag

# Nội dung tùy chọn
FACEBOOK_POST_URL=
SITE_DOMAIN_TEXT=linkcuaban.vn
VOUCHER_IMAGE_URL=/images/voucher.jpg
